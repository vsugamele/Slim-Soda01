{
  "rewrites": [
    {
      "source": "/methodology/(.*)",
      "destination": "/references_v5/methodology/$1"
    },
    {
      "source": "/tracking/(.*)",
      "destination": "/references_v5/tracking/$1"
    },
    {
      "source": "/by-product/(.*)",
      "destination": "/references_v5/by-product/$1"
    },
    {
      "source": "/",
      "destination": "/references_v5/"
    }
  ],
  "headers": [
    {
      "source": "/(.*)\\.(jpg|jpeg|png|gif|webp|svg|ico|webm|mp4)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    },
    {
      "source": "/js/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    },
    {
      "source": "/chat-x1/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=3600, must-revalidate"
        }
      ]
    },
    {
      "source": "/chat-x1-memoflow/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=3600, must-revalidate"
        }
      ]
    },
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "Referrer-Policy",
          "value": "strict-origin-when-cross-origin"
        }
      ]
    }
  ],
  "crons": [
    {
      "path": "/api/cron/refresh-spy",
      "schedule": "0 9 * * 1"
    },
    {
      "path": "/api/cron/daily-decision",
      "schedule": "0 8 * * *"
    }
  ]
}
